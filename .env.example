# Screen Tracker Configuration Template

# Interval between captures in seconds
SCREEN_INTERVAL_SECONDS=60.0

# Directory to save captured screenshot images
SCREEN_OUTPUT_DIR=./screenshots

# Path to the SQLite database
SCREEN_DB_PATH=./tracker.db

# Store raw image bytes inside the SQLite database (true / false)
SCREEN_STORE_BLOB=false

# OCR Language (default: eng)
OCR_LANGUAGE=eng

# Custom path to tesseract binary if not in PATH (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=

# GitHub Push settings
GIT_ENABLED=false
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_REPO_DIR=.
GIT_COMMIT_PREFIX=[Auto-Capture]
